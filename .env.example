# Copy to .env and fill in. .env is gitignored - never commit real values.

# From @BotFather when you create the bot (looks like 123456789:AAH...).
TELEGRAM_BOT_TOKEN=

# Where signals and reports are sent. Message your bot once, then run
#   python -m trade_bot --whoami
# and paste the id it prints. Group ids are negative.
TELEGRAM_CHAT_ID=

# Optional. Chats allowed to send the bot commands. Defaults to TELEGRAM_CHAT_ID.
# Comma separated. Anything not listed here is ignored.
# TELEGRAM_ALLOWED_CHAT_IDS=

# Optional. Long-poll timeout in seconds (default 25).
# TELEGRAM_POLL_TIMEOUT=25

# Optional. File used to remember the last handled update across restarts,
# so a restart does not replay old messages.
# TELEGRAM_OFFSET_FILE=.state/telegram-offset

# Optional. HTML (default) or MarkdownV2.
# TELEGRAM_PARSE_MODE=HTML

# ---------------------------------------------------------------------------
# Health monitoring
# ---------------------------------------------------------------------------

# Alert if the trading loop stops calling monitor.beat() for this many seconds.
# On by default - it only speaks when something is wrong. 0 disables it.
# HEALTH_WATCHDOG_TIMEOUT=300

# Send a periodic "still alive" report every N seconds. Off by default,
# because it is a recurring message even when nothing is wrong.
# 3600 = hourly, 86400 = daily.
# HEALTH_HEARTBEAT_INTERVAL=0

# Serve GET /healthz for Docker or an uptime monitor. Unset = no server.
# HEALTH_HTTP_PORT=8080
# HEALTH_HTTP_HOST=127.0.0.1
